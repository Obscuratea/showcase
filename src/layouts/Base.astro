---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const { title, description = 'A showcase of the things I build.' } = Astro.props;
const pageTitle = title ? `${title} · Showcase` : 'Showcase';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#262626" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand grad-text" href="/">Showcase</a>
        <nav aria-label="Main">
          <a class="pill" href="/" aria-current={path === '/' ? 'page' : undefined}>Home</a>
          <a class="pill" href="/#projects">Projects</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer"><div class="wrap">© {new Date().getFullYear()} · Built with Astro</div></footer>
  </body>
</html>
