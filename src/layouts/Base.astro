---
import '../styles/global.css';

interface Props { title?: string; description?: string; image?: string; }
const siteName = '8bin';
const defaultDescription = 'Desktop software: two audio mixers, an anime tracker and a printer manager.';
const { title, description = defaultDescription, image = '/og.png' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · Projects`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#262626" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${siteName} home`}>
          <svg class="infinity" viewBox="8 16 48 32" aria-hidden="true">
            <defs>
              <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="#b3a0ff" />
                <stop offset="1" stop-color="#ff86bd" />
              </linearGradient>
            </defs>
            <path d="M32 32C38 22 51 22 51 32C51 42 38 42 32 32C26 22 13 22 13 32C13 42 26 42 32 32Z" fill="none" stroke="url(#brand-g)" stroke-width="6" stroke-linejoin="round" />
          </svg>
          <span class="grad-text">bin</span>
        </a>
        <nav aria-label="Main">
          <a class="pill" href="/" aria-current={path === '/' ? 'page' : undefined}>Projects</a>
          <a class="pill" href="https://github.com/Obscuratea">GitHub</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} {siteName}</div>
    </footer>
  </body>
</html>
