---
import '../styles/global.css';

interface Props { title?: string; description?: string; image?: string; }
const siteName = 'Obscuratea';
const defaultDescription = 'Desktop software: two audio mixers, an anime tracker and a printer manager.';
const { title, description = defaultDescription, image = '/og.png' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : `${siteName} · Projects`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#262626" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand grad-text" href="/">{siteName}</a>
        <nav aria-label="Main">
          <a class="pill" href="/" aria-current={path === '/' ? 'page' : undefined}>Projects</a>
          <a class="pill" href="https://github.com/Obscuratea">GitHub</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">© {new Date().getFullYear()} {siteName}</div>
    </footer>
  </body>
</html>
