---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base>
  <section class="hero">
    <div>
      <h1>Things I <span class="grad-text">build</span>.</h1>
      <p>A collection of my projects: tools, apps and experiments. Placeholder intro, we'll write the real one together.</p>
      <div class="actions">
        <a class="pill primary" href="#projects">See projects</a>
      </div>
    </div>
    <div class="hero-tile" aria-hidden="true"><span class="grad-text">UI</span></div>
  </section>

  <h2 class="section-title" id="projects">Projects</h2>
  <div class="grid">
    {projects.map((p, i) => (
      <a class="card" href={`/projects/${p.id}/`}>
        <h3>{p.data.title}</h3>
        <p>{p.data.summary}</p>
        <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        <div class="meter" aria-hidden="true"><i style={`--w:${40 + ((i * 17) % 50)}%`}></i></div>
        <span class="more grad-text">View project →</span>
      </a>
    ))}
  </div>
</Base>
