---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, repo, link, linkLabel, image, imageAlt, gallery } = project.data;
---
<Base title={title} description={summary} image={image}>
  <article class="project">
    <a class="pill" href="/#projects">← All projects</a>
    <h1 class="grad-text">{title}</h1>
    <p class="lede">{summary}</p>
    <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>

    <div class="links">
      {repo && <a class="pill primary" href={repo}>Source on GitHub</a>}
      {link && <a class="pill" href={link}>{linkLabel}</a>}
    </div>

    {image && (
      <figure class="shot shot-lg"><img src={image} alt={imageAlt} /></figure>
    )}

    <div class="body"><Content /></div>

    {gallery.length > 0 && (
      <section aria-label="Screenshots">
        <h2 class="section-title">Screenshots</h2>
        <div class="gallery">
          {gallery.map((g) => (
            <figure class="shot">
              <img src={g.src} alt={g.alt} loading="lazy" />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </article>
</Base>
