---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { id: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, summary, tags, repo, link } = project.data;
---
<Base title={title} description={summary}>
  <article class="project">
    <a class="pill" href="/#projects">← All projects</a>
    <h1 class="grad-text">{title}</h1>
    <div class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</div>
    <div class="body"><Content /></div>
    <div class="links">
      {link && <a class="pill primary" href={link}>Visit</a>}
      {repo && <a class="pill" href={repo}>Source</a>}
    </div>
  </article>
</Base>
